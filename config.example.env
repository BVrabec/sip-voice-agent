# Settings for the voice call agent. Copy to config.env and fill in the top block.
#   cp config.example.env config.env && chmod 600 config.env
#
# Every value below can also be given on the command line; the environment wins over the
# code defaults. Nothing here is written to a log, and call.sh never prints it.

# ---- the two things you must supply -----------------------------------------
# A SIP account (any provider: Linphone, a PBX, Twilio's SIP, your own Asterisk).
SIP_USER=
SIP_PASS=
SIP_GATEWAY=sip.linphone.org
SIP_TRANSPORT=udp                 # udp, or tcp when a carrier NAT rebinds mid-call
SIP_MEDIAENC=srtp-mand            # srtp-mand | srtp-opt | none (Linphone wants SRTP)

# The number that rings (the phone you are calling). A full URI is safest:
#   TARGET_SIP=sip:+441234567890@sip.example.net
TARGET_SIP=

# ---- the two brains ---------------------------------------------------------
# Speech in and out goes to OpenRouter.
OPENROUTER_API_KEY=

# The replies come from any OpenAI-compatible chat endpoint. The default is a Hermes agent
# listening on this machine; point it at OpenAI, OpenRouter, Ollama or anything else if you
# would rather.
HERMES_API_URL=http://127.0.0.1:8642/v1/chat/completions
HERMES_API_KEY=
HERMES_MODEL=hermes-agent

# ---- the voice and the ears -------------------------------------------------
TTS_MODEL=elevenlabs/eleven-flash-v2.5
TTS_VOICE=sarah
TTS_PROVIDER=elevenlabs
STT_MODEL=openai/whisper-large-v3-turbo

# ---- how it behaves ---------------------------------------------------------
AGENT_NAME=Jarvis                 # what it calls itself; spoken, so never spell it out
KNOWLEDGE_DIR=                    # optional folder of notes it may search when you ask about yourself
CLOSE_LINE=Goodbye.               # said on the way out
VAD_SILENCE_S=0.5                 # silence that ends your turn. Raise for long answers
BARGE_MIN_S=0.3                   # seconds of your voice needed to interrupt it
MAX_SPOKEN_SENTENCES=3            # how much of a reply is spoken (the transcript keeps the rest)
MAX_SPOKEN_CHARS=160
STREAM_HERMES=1                   # speak each sentence as it arrives, rather than the whole reply
PHONE_MODEL=                      # optional: pin the model for the line (needs a provider field)
PHONE_REASONING=none              # none is the fastest; reasoning tokens are pure delay on a call
STT_LANG=en
STT_RETRY_S=6
